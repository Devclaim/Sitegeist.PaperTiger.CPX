from "./AltchaFieldProps.cpx" import { AltchaFieldProps }

export component AltchaField {
  field: AltchaFieldProps

  render <altcha-widget
    class="papertiger-field__control--altcha"
    auto={field.auto}
    display={field.display}
    type={field.type}
    configuration={field.configuration}
    challenge={field.challengeUrl}
    name={field.name}
  ></altcha-widget>
}
